# Optional. Leave empty for local development so the API follows the page
# hostname (localhost or 127.0.0.1) and donor session cookies remain same-site.
VITE_API_BASE_URL=

# Umami analytics (leave empty to disable)
VITE_UMAMI_HOST=https://analytics.example.org
VITE_UMAMI_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Shareable Umami dashboard link for the Admin page iframe (optional)
VITE_UMAMI_DASHBOARD_URL=
