APP_NAME=Love 21 Community API
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Umami analytics (disabled by default; enable to send anonymized events)
UMAMI_ENABLED=false
UMAMI_HOST=https://analytics.example.org
UMAMI_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Umami Cloud API key (for the admin analytics report; Settings > API keys)
UMAMI_API_KEY=
UMAMI_API_BASE=https://api.umami.is/v1
