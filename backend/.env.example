APP_NAME=Love 21 Community API
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Umami analytics (disabled by default; enable to send anonymized events)
UMAMI_ENABLED=false
UMAMI_HOST=https://analytics.example.org
UMAMI_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Social publishing from the admin page
# Leave META_USER_ACCESS_TOKEN empty to disable publishing entirely.
META_USER_ACCESS_TOKEN=
META_PAGE_ID= # Optional

# Cloudinary hosts the uploaded image so Meta can fetch it. Meta downloads the image over the public internet.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
